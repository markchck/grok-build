# 값은 전부 예시다. 실제 키를 절대 넣지 않는다.
# 이름은 ai/llm-agent-tutorial/PROJECT-SPEC.md 2절에 고정되어 있다. 이후 단계도 이 이름을 그대로 쓴다.
# DOCAGENT_MCP_* 네 개는 10단계에서 새로 추가했다.

# OpenAI 호환 모델 서버 (docagent 쪽 채팅 + mcp_server 쪽 임베딩이 함께 쓴다)
OPENAI_BASE_URL=http://localhost:8000/v1
OPENAI_API_KEY=sk-local-example-key
CHAT_MODEL=your-chat-model-name
EMBEDDING_MODEL=your-embedding-model-name

# Milvus (mcp_server가 검색 도구에서 쓴다. 이 장은 Milvus Lite 파일 경로도 그대로 쓸 수 있다)
DOCAGENT_MILVUS_URI=http://localhost:19530
DOCAGENT_MILVUS_TOKEN=
DOCAGENT_MILVUS_COLLECTION=docagent_chunks

# 애플리케이션
APP_BASE_URL=http://localhost:8080
REQUEST_TIMEOUT_SECONDS=60
MAX_AGENT_STEPS=8
MAX_AGENT_SECONDS=120

# MCP 서버 연결 (10단계 추가)
# mcp_server를 어떤 명령으로 띄울지. args는 콤마로 구분한다(docagent/config.py 참고).
DOCAGENT_MCP_SERVER_COMMAND=python
DOCAGENT_MCP_SERVER_ARGS=-m,mcp_server.server
DOCAGENT_MCP_CONNECT_TIMEOUT_SECONDS=5
DOCAGENT_MCP_CALL_TIMEOUT_SECONDS=20

# mcp_server 쪽 CSV 조회 도구가 읽을 파일 경로 (10단계 추가)
DOCAGENT_MCP_SALES_CSV=./data/sales.csv
